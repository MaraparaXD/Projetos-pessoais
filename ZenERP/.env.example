# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA faça commit do arquivo ".env" preenchido — adicione-o ao .gitignore.

# Conexão com o Azure SQL
ZENERP_DB_SERVER=seuservidor.database.windows.net
ZENERP_DB_NAME=seubanco
ZENERP_DB_USER=seuusuario
ZENERP_DB_PASSWORD=suasenha

# Login de acesso ao ZenERP (tela de login)
ZENERP_APP_USER=admin
ZENERP_APP_PASSWORD=defina-uma-senha-forte-aqui
