ENVIRONMENT=development
DATABASE_URL=sqlite:///./sentinel.db
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@sentinel.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
BOOTSTRAP_WEBHOOK_SECRET=CHANGE_WEBHOOK_SECRET
INTEGRATION_ENCRYPTION_KEY=CHANGE_ENCRYPTION_KEY
REDIS_URL=
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
SESSION_HOURS=8
REOPEN_WINDOW_SECONDS=900
FLAPPING_WINDOW_SECONDS=600
FLAPPING_THRESHOLD=4
EVENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
