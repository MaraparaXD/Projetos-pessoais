# Copie este arquivo para "dados.env" e preencha com seus valores reais.
# NUNCA faça commit do arquivo "dados.env" preenchido — ele já está no .gitignore.

# Conexão com o Oracle
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_CONNECT_STRING=host:porta/servico
ORACLE_HOME=C:\Program Files\Oracle Client for Microsoft Tools
PORT=8000

# Token exigido no header X-API-Token para acessar a API
API_TOKEN=defina-um-token-forte-e-aleatorio-aqui

# Origens autorizadas a chamar a API via navegador (CORS), separadas por vírgula.
# Exemplo em desenvolvimento local: http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000
