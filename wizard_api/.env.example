# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA faça commit do arquivo ".env" preenchido.

# Chave exigida no header x-api-key para acessar o endpoint /v1/analyze
WIZARD_API_KEY=defina-uma-chave-forte-e-aleatoria-aqui

# Conexão com o SQL Server (usa autenticação do Windows por padrão)
WIZARD_DB_SERVER=localhost
WIZARD_DB_NAME=ENGINE
